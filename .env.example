# ===================================
# ContCatLog Environment Variables
# ===================================

# Database connection string
# Format: mysql://username:password@host:port/database
# Note: SSL/TLS is automatically enabled for secure connections
DATABASE_URL=mysql://contcatlog_user:your_password@localhost:3306/contcatlog

# Optional table namespace inside a shared database.
# Example:
# - empty => tables like containers, container_photos
# - "catalog_" => tables like catalog_containers, catalog_container_photos
CATALOG_TABLE_PREFIX=

# Data Layer API base (source of "В наличии")
# Example: https://mi4gang-data-layer-sync-116e.twc1.net
DATA_LAYER_API_BASE_URL=

# Automatic sync from Data Layer to catalog
CATALOG_AUTO_SYNC_ENABLED=true
CATALOG_AUTO_SYNC_INTERVAL_MINUTES=60
CATALOG_AUTO_SYNC_RUN_ON_START=false

# JWT secret for session cookies (generate with: openssl rand -base64 32)
JWT_SECRET=your_random_secret_key_here_min_32_characters_long

# Application mode (development or production)
NODE_ENV=production

# Server port (default: 3000)
PORT=3000
